# Copy to .env for local development: cp .env.example .env

# --- Local Postgres (docker-compose.yml) ---
POSTGRES_USER=hvac
POSTGRES_PASSWORD=hvac
POSTGRES_DB=hvac
POSTGRES_PORT=5432

# --- Server ---
# Validated at startup by server/utils/env.ts
DATABASE_URL=postgresql://hvac:hvac@localhost:5432/hvac?schema=public

# --- Seed (prisma/seed.ts) ---
# Demo users/customers/jobs are seeded unless NODE_ENV=production; set to 1 or 0 to override.
#SEED_DEMO=1

# Seals the session cookie. At least 32 characters. Use a unique secret in production.
NUXT_SESSION_PASSWORD=dev-only-change-me-please-32-chars-min

# --- Public runtime config (exposed to the browser) ---
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Local stand-in for object storage. Company logos are written here until S3 or R2 is configured.
# UPLOAD_DIR=.data/uploads
